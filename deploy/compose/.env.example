# Copy to deploy/compose/.env (never committed) and fill in your own values.

# Keycloak admin console (http://localhost:8080/admin)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin-password

# Password for ALL demo users (at least 12 characters). Change it here, then
# re-run:  docker compose -f deploy/compose/docker-compose.yml up keycloak-init
KONTOR_DEMO_PASSWORD=change-me-demo-password

# Shared secret between Keycloak's "kontor-web" client and the Next.js server.
# Must be identical to KONTOR_OIDC_CLIENT_SECRET in web/.env.local.
KONTOR_OIDC_CLIENT_SECRET=change-me-client-secret
