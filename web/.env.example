# Copy to .env.local (never committed). Server-only: no NEXT_PUBLIC_ prefix,
# so these values never reach the browser.

# Where the Kontor core API runs (deploy/compose/docker-compose.yml).
KONTOR_API_URL=http://localhost:8000

# This app's public address (used for the OpenID Connect redirect).
KONTOR_APP_URL=http://localhost:3000

# Keycloak (OpenID Connect identity provider). Realms: customers, kontor-staff.
KONTOR_OIDC_ISSUER_BASE=http://localhost:8080
KONTOR_OIDC_CLIENT_ID=kontor-web
# Must be identical to KONTOR_OIDC_CLIENT_SECRET in deploy/compose/.env.
KONTOR_OIDC_CLIENT_SECRET=change-me-client-secret

# Encrypts the session cookies (at least 32 random characters).
KONTOR_SESSION_SECRET=change-me-to-at-least-32-random-characters
